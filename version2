def apply_snv(X):
    """Apply Standard Normal Variate normalization"""
    if len(X.shape) == 1:
        X = X.reshape(1, -1)
    
    mean = X.mean(axis=1, keepdims=True)
    std = X.std(axis=1, keepdims=True)
    std[std == 0] = 1
    
    return (X - mean) / std

